# Disable all default warnings, then enable all of the groups we want, then disable specific cases.
Checks: '-*,
fuchsia-default-arguments-declarations,
bugprone-*,
cppcoreguidelines-*,
performance-*,
-bugprone-command-processor,
-bugprone-easily-swappable-parameters,
-bugprone-narrowing-conversions,
-bugprone-random-generator-seed,
-bugprone-throwing-static-initialization,
-cppcoreguidelines-avoid-c-arrays,
-cppcoreguidelines-avoid-const-or-ref-data-members,
-cppcoreguidelines-avoid-do-while,
-cppcoreguidelines-avoid-magic-numbers,
-cppcoreguidelines-init-variables,
-cppcoreguidelines-macro-to-enum,
-cppcoreguidelines-non-private-member-variables-in-classes,
-cppcoreguidelines-owning-memory,
-cppcoreguidelines-pro-bounds-array-to-pointer-decay,
-cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
-cppcoreguidelines-pro-bounds-constant-array-index,
-cppcoreguidelines-pro-bounds-pointer-arithmetic,
-cppcoreguidelines-pro-type-cstyle-cast,
-cppcoreguidelines-pro-type-reinterpret-cast,
-cppcoreguidelines-pro-type-vararg,
-modernize-avoid-c-arrays,
-performance-enum-size,

-bugprone-exception-escape,
-bugprone-implicit-widening-of-multiplication-result,
-bugprone-unchecked-string-to-number-conversion,
-cppcoreguidelines-pro-type-member-init,
-cppcoreguidelines-use-default-member-init,
-cppcoreguidelines-narrowing-conversions,
-cppcoreguidelines-prefer-member-initializer,
'
# these are maybes:
# bugprone-exception-escape - maybe with options
# bugprone-implicit-widening-of-multiplication-result with IgnoreConstantIntExpr:true
# bugprone-unchecked-string-to-number-conversion - replace with string_utils fast string
# cppcoreguidelines-pro-type-member-init - need to initialise EVERY member of every struct
# cppcoreguidelines-use-default-member-init - same as ^
# cppcoreguidelines-narrowing-conversions - could complement the MSVC narrowing warnings
# cppcoreguidelines-prefer-member-initializer - style choice (wants member list only)

WarningsAsErrors: '*'

ExcludeHeaderFilterRegex: '3rdparty'

CheckOptions:
  - key:    performance-move-const-arg.CheckTriviallyCopyableMove
    value:  0
  - key:    cppcoreguidelines-no-malloc.Deallocations
    value:  "" # ignore calls to free() since our dependencies return malloc'd pointers
  - key:    cppcoreguidelines-avoid-do-while.IgnoreMacros
    value:  true # ignore do-while in macros, ie in catch2
  - key:    cppcoreguidelines-macro-usage.CheckCapsOnly
    value:  true # ignore CAPS_ONLY macros (value is inverted for some reason)
  - key:    bugprone-unchecked-optional-access.IgnoreValueCalls
    value:  true # optional.value() throws so it's safe to use
  - key:    modernize-use-override.IgnoreDestructors
    value:  true # TODO: do we want this too?
